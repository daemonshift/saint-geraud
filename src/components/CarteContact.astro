---
/**
 * Carte d'un contact de démarche (Infos pratiques, Rubrique Contacts) : un
 * rôle, jamais un nom de bénévole, et ses deux moyens de contact (e-mail en
 * clair, téléphone). Même source sur La paroisse et Prier et célébrer :
 *
 *   const contact = contactPour(infosPratiques.contacts, 'Baptême');
 *   {contact && <CarteContact contact={contact} />}
 */
import type { ContactDemarche } from '../lib/contenu';
import { pictogrammeDeDemarche } from '../lib/pictogrammes';
import MoyensDeContact from './MoyensDeContact.astro';
import Pictogramme from './Pictogramme.astro';

interface Props {
  contact: ContactDemarche;
  niveauTitre?: 'h2' | 'h3';
}

const { contact, niveauTitre: Titre = 'h3' } = Astro.props;
---

<article id={`contact-${contact.cle}`} class="flex h-full scroll-mt-6 flex-col items-center gap-3 rounded-xl border border-or-doux bg-blanc px-5 py-6 text-center lg:px-6 lg:py-8">
  <Pictogramme nom={pictogrammeDeDemarche(contact.role)} />
  <Titre class="mt-1 font-texte text-lg font-bold tracking-wider break-words text-or-fonce uppercase">{contact.role}</Titre>
  {contact.precision && <p class="text-gris-vert">{contact.precision}</p>}
  <MoyensDeContact contact={contact} />
</article>
