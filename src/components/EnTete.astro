---
/**
 * En-tête du site : logotype, navigation principale, menu mobile.
 *
 * - Ordinateur (≥ lg) : barre utilitaire + rubriques en ligne, bouton « Horaires des messes ».
 * - Mobile : logotype, bouton Menu (✕ quand il est ouvert) et, sous la barre,
 *   « Horaires des messes » toujours visible sans ouvrir le menu.
 * Le menu se ferme par ✕, Échap (focus rendu au bouton Menu) ou au choix d'un lien.
 */
import { Image } from 'astro:assets';
import logo from '../assets/logo-saint-geraud.jpg';
import { HORAIRES_DES_MESSES, LETTRE_D_INFORMATION, NOUS_CONTACTER, RUBRIQUES, estPageCourante } from '../lib/navigation';
import { LIENS_EXTERNES } from '../lib/contenu-provisoire';

const chemin = Astro.url.pathname;
const courant = (href: string) => (estPageCourante(href, chemin) ? 'page' : undefined);
---

<header class="relative z-20 border-b border-or-doux bg-blanc">
  <div class="hidden bg-vert-profond text-ivoire lg:block">
    <div class="conteneur flex justify-end gap-6">
      <a class="flex min-h-12 items-center text-ivoire" href={LIENS_EXTERNES.diocese}>Diocèse d’Agen (site du diocèse)</a>
      <a class="flex min-h-12 items-center text-ivoire" href={LETTRE_D_INFORMATION.href}>{LETTRE_D_INFORMATION.libelle}</a>
      <a class="flex min-h-12 items-center text-ivoire" href={NOUS_CONTACTER.href}>{NOUS_CONTACTER.libelle}</a>
    </div>
  </div>

  <div class="conteneur relative flex flex-wrap items-center gap-x-6 gap-y-2 py-2">
    <a href="/" class="flex min-h-12 min-w-0 flex-1 items-center gap-3 text-encre no-underline lg:flex-none">
      <Image src={logo} alt="" width={96} height={72} class="h-12 w-auto shrink-0 lg:h-[72px]" loading="eager" />
      <span class="flex min-w-0 flex-col leading-tight">
        <span class="font-titre text-xl font-bold text-vert-profond lg:text-2xl">Paroisse Saint&#8209;Géraud</span>
        <span data-logotype class="text-logotype tracking-wide text-gris-vert uppercase">des Vallées en Fumélois</span>
      </span>
    </a>

    <!-- Emplacement du bouton « Aa » (ticket #14), avant le bouton Menu. -->
    <slot name="outils" />

    <button
      id="bouton-menu"
      type="button"
      class="flex size-12 shrink-0 items-center justify-center rounded-lg border-2 border-vert-profond bg-blanc text-vert-profond aria-expanded:bg-vert-profond aria-expanded:text-ivoire lg:hidden"
      aria-expanded="false"
      aria-controls="menu-principal"
      aria-label="Menu"
    >
      <svg class="icone-ouvrir size-7" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
        <path d="M4 6h16M4 12h16M4 18h16"></path>
      </svg>
      <svg class="icone-fermer hidden size-7" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
        <path d="M6 6l12 12M18 6L6 18"></path>
      </svg>
    </button>

    <nav
      id="menu-principal"
      aria-label="Menu principal"
      class="absolute inset-x-0 top-full hidden border-b-4 border-or-doux bg-blanc px-4 pb-5 shadow-lg data-ouvert:block lg:static lg:ml-auto lg:flex lg:border-0 lg:p-0 lg:shadow-none"
    >
      <ul class="flex flex-col lg:flex-row lg:flex-wrap lg:items-center lg:gap-x-2">
        {
          RUBRIQUES.map(({ libelle, href }) => (
            <li>
              <a
                href={href}
                aria-current={courant(href)}
                class="flex min-h-14 items-center border-b border-beige-filet font-semibold text-encre no-underline hover:underline aria-[current=page]:font-bold aria-[current=page]:text-vert-profond lg:min-h-12 lg:border-0 lg:px-2"
              >
                {libelle}
              </a>
            </li>
          ))
        }
        <li class="lg:hidden">
          <a href={NOUS_CONTACTER.href} class="flex min-h-14 items-center border-b border-beige-filet font-semibold text-encre no-underline">
            {NOUS_CONTACTER.libelle}
          </a>
        </li>
        <li class="mt-4 lg:mt-0 lg:ml-2">
          <a href={HORAIRES_DES_MESSES.href} aria-current={courant(HORAIRES_DES_MESSES.href)} class="bouton-principal w-full lg:w-auto">
            {HORAIRES_DES_MESSES.libelle}
          </a>
        </li>
        <li class="mt-2 lg:hidden">
          <a href={LETTRE_D_INFORMATION.href} class="flex min-h-12 items-center text-encre">{LETTRE_D_INFORMATION.libelle}</a>
        </li>
        <li class="lg:hidden">
          <a href={LIENS_EXTERNES.diocese} class="flex min-h-12 items-center text-encre">Diocèse d’Agen (site du diocèse)</a>
        </li>
      </ul>
    </nav>
  </div>

  <div class="border-t border-beige-filet bg-ivoire lg:hidden">
    <div class="conteneur py-2">
      <a href={HORAIRES_DES_MESSES.href} class="bouton-principal w-full">{HORAIRES_DES_MESSES.libelle}</a>
    </div>
  </div>
</header>

<style>
  #bouton-menu[aria-expanded='true'] .icone-ouvrir {
    display: none;
  }
  #bouton-menu[aria-expanded='true'] .icone-fermer {
    display: block;
  }
</style>

<script>
  // Îlot du menu mobile. Fermeture par ✕ ou Échap : le focus revient au bouton Menu.
  // Au choix d'un lien, le menu se ferme et la navigation suit son cours.
  const bouton = document.getElementById('bouton-menu');
  const menu = document.getElementById('menu-principal');

  if (bouton && menu) {
    const estOuvert = () => bouton.getAttribute('aria-expanded') === 'true';

    const ouvrir = () => {
      bouton.setAttribute('aria-expanded', 'true');
      menu.toggleAttribute('data-ouvert', true);
    };

    const fermer = (rendreLeFocus: boolean) => {
      bouton.setAttribute('aria-expanded', 'false');
      menu.toggleAttribute('data-ouvert', false);
      if (rendreLeFocus) bouton.focus();
    };

    bouton.addEventListener('click', () => (estOuvert() ? fermer(true) : ouvrir()));

    document.addEventListener('keydown', (evenement) => {
      if (evenement.key === 'Escape' && estOuvert()) fermer(true);
    });

    menu.addEventListener('click', (evenement) => {
      if (estOuvert() && (evenement.target as Element).closest('a')) fermer(false);
    });
  }
</script>
