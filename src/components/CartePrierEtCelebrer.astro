---
/**
 * Carte de Prier et célébrer (texte en Markdown dans
 * src/content/prier-et-celebrer/) : médaillon, titre, sous-titre, texte,
 * puis le contact de la démarche (Infos pratiques, même source que La
 * paroisse ; à défaut le presbytère) ou un bouton vers une page du site.
 * Sur mobile, un lien « Haut de page » termine la carte.
 */
import { render, type CollectionEntry } from 'astro:content';
import { contactOuPresbytere, type InfosPratiques } from '../lib/contenu';
import MoyensDeContact from './MoyensDeContact.astro';
import Pictogramme from './Pictogramme.astro';

interface Props {
  carte: CollectionEntry<'prierEtCelebrer'>;
  infosPratiques: InfosPratiques;
}

const { carte, infosPratiques } = Astro.props;
const { titre, sousTitre, pictogramme, contact: role, lien } = carte.data;
const contact = role ? contactOuPresbytere(infosPratiques, role) : null;
const { Content } = await render(carte);
---

<article id={carte.id} class="flex h-full scroll-mt-6 flex-col items-center gap-3 rounded-xl border border-or-doux bg-blanc px-5 py-6 text-center lg:px-6 lg:pt-8 lg:pb-7">
  <Pictogramme nom={pictogramme} />
  <h3 class="mt-1 font-texte text-xl font-bold tracking-wider break-words text-or-fonce uppercase">{titre}</h3>
  <p class="font-bold tracking-wide text-vert-profond uppercase">{sousTitre}</p>
  <div class="flex flex-col gap-2 text-encre">
    <Content />
    {contact?.precision && <p class="text-gris-vert">{contact.precision}</p>}
  </div>
  {contact && <MoyensDeContact contact={contact} />}
  {
    lien && (
      <p class="mt-auto w-full pt-2">
        <a class="bouton-principal w-full" href={lien.href}>
          {lien.libelle}
        </a>
      </p>
    )
  }
  <a href="#top" class="inline-flex min-h-12 items-center text-vert-profond underline lg:hidden">
    <span aria-hidden="true">↑&nbsp;</span>Haut de page
  </a>
</article>
