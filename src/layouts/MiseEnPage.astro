---
/**
 * Mise en page commune à toutes les pages : lien « Aller au contenu », en-tête,
 * contenu principal (`<main id="contenu">`), pied de page « Nous contacter ».
 *
 * Usage :
 *   <MiseEnPage titre="Nos églises" description="…">…contenu…</MiseEnPage>
 *
 * Emplacements :
 * - `head`   : balises supplémentaires dans <head> ;
 * - `outils` : boutons de l'en-tête avant le bouton Menu, après le bouton « Aa ».
 */
import '../styles/global.css';
import EnTete from '../components/EnTete.astro';
import PiedDePage from '../components/PiedDePage.astro';
import BoutonTailleTexte from '../components/BoutonTailleTexte.astro';
import { CLE_TAILLE_DU_TEXTE, TAILLE_GRANDE } from '../lib/taille-du-texte';
import { contenuDuSite } from '../lib/contenu/site';

interface Props {
  /** Titre propre à la page ; « Accueil » donne le nom seul de la paroisse. */
  titre: string;
  description?: string;
}

const NOM_DU_SITE = 'Paroisse Saint-Géraud des Vallées en Fumélois';
const { titre, description = 'Site de la paroisse Saint-Géraud des Vallées en Fumélois (diocèse d’Agen) : horaires des messes, églises, actualités et contacts.' } = Astro.props;
const { infosPratiques } = await contenuDuSite();
const titreComplet = titre === 'Accueil' ? NOM_DU_SITE : `${titre} — ${NOM_DU_SITE}`;
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titreComplet}</title>
    <meta name="description" content={description} />
    <!-- Taille du texte choisie avec le bouton « Aa », appliquée avant l'affichage. -->
    <script is:inline define:vars={{ cle: CLE_TAILLE_DU_TEXTE, grand: TAILLE_GRANDE }}>
      try {
        if (localStorage.getItem(cle) === grand) document.documentElement.dataset.taille = grand;
      } catch (e) {}
    </script>
    <slot name="head" />
  </head>
  <body class="flex min-h-screen flex-col">
    <a
      href="#contenu"
      class="bouton-principal absolute top-2 left-2 z-50 -translate-y-[200%] focus:translate-y-0"
    >
      Aller au contenu
    </a>
    <EnTete>
      <BoutonTailleTexte slot="outils" />
      <slot name="outils" slot="outils" />
    </EnTete>
    <main id="contenu" tabindex="-1" class="flex-1 focus:outline-none">
      <slot />
    </main>
    <PiedDePage presbytere={infosPratiques.presbytere} />
  </body>
</html>
