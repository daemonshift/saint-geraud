---
/**
 * Carte d'un Groupe (La paroisse, `#associations`) : image (logo ou lieu,
 * avec son texte alternatif) ou pictogramme selon le Type, nom, description,
 * contact du groupe ou du presbytère, lien facultatif vers son site.
 */
import type { Groupe } from '../lib/contenu';
import { pictogrammeDeGroupe } from '../lib/pictogrammes';
import MoyensDeContact from './MoyensDeContact.astro';
import Pictogramme from './Pictogramme.astro';

interface Props {
  groupe: Groupe;
  niveauTitre?: 'h3' | 'h4';
}

const { groupe, niveauTitre: Titre = 'h4' } = Astro.props;
const { contact } = groupe;
// Le Contact peut déjà être le site du groupe : un seul lien.
const siteWeb = groupe.siteWeb && groupe.siteWeb !== contact.site ? groupe.siteWeb : null;
---

<article id={`groupe-${groupe.id}`} class="flex h-full scroll-mt-6 flex-col items-center gap-3 rounded-xl border border-or-doux bg-blanc px-5 py-6 text-center lg:px-6 lg:py-8">
  {
    groupe.image ? (
      <img
        src={groupe.image.chemin}
        alt={groupe.image.texteAlternatif}
        width="120"
        height="120"
        loading="lazy"
        class="size-22 rounded-full border-2 border-vert-sauge bg-blanc object-contain lg:size-30"
      />
    ) : (
      <Pictogramme nom={pictogrammeDeGroupe(groupe.type)} />
    )
  }
  <Titre class="mt-1 font-texte text-lg font-bold tracking-wider break-words text-or-fonce uppercase">{groupe.nom}</Titre>
  {groupe.description && <p class="whitespace-pre-line text-gris-vert">{groupe.description}</p>}
  <MoyensDeContact contact={contact}>
    {contact.duPresbytere && <li slot="avant" class="text-gris-vert">Contact : le presbytère</li>}
    {
      contact.site && (
        <li>
          <a class="bouton-principal w-full" href={contact.site}>
            Contacter {groupe.nom} (site du groupe)
          </a>
        </li>
      )
    }
    {
      siteWeb && (
        <li>
          <a class="bouton-secondaire w-full" href={siteWeb}>
            Découvrir {groupe.nom} (site du groupe)
          </a>
        </li>
      )
    }
  </MoyensDeContact>
</article>
