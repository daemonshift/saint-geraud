---
/**
 * Section « Horaires des messes » de l'Accueil (maquettes 1440 et 390) : texte
 * d'introduction à gauche, widget messes.info à droite en ordinateur ; une
 * colonne en mobile.
 */
import WidgetMessesInfo from './WidgetMessesInfo.astro';
---

<section
  id="horaires"
  aria-labelledby="titre-horaires-des-messes"
  class="border-y border-beige-filet bg-blanc py-10 lg:py-18"
>
  <div class="conteneur grid gap-6 lg:grid-cols-[minmax(0,1fr)_minmax(0,1.6fr)] lg:gap-12">
    <div class="flex flex-col gap-4">
      <h2 id="titre-horaires-des-messes" class="text-3xl tracking-wide uppercase lg:text-4xl">Horaires des messes</h2>
      <p>Les horaires sont publiés par le diocèse d’Agen sur messes.info et se mettent à jour automatiquement.</p>
    </div>
    <WidgetMessesInfo />
  </div>
</section>
